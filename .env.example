# Supabase (Database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-server-only

# Google Drive Picker API & OAuth 2.0 (Frontend safe client ID + Picker key)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=your-google-picker-api-key

# AI Chatbot (Server-side only - NEVER expose to frontend)
GEMINI_API_KEY=your-gemini-api-key

# Cổng thanh toán Việt Nam (VNPay / MoMo)
NEXT_PUBLIC_SITE_URL=https://casestudio.vn
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
